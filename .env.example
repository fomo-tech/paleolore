# Public site URL used for canonical links, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.paleolore.com
NEXT_PUBLIC_ADSENSE_CLIENT=

# CMS authentication. Use long random values in production.
ADMIN_PASSWORD=change-me-before-deploy
ADMIN_SECRET=replace-with-a-long-random-secret

# MongoDB connection string. MONGO_URI is also supported as an alias.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=archaeologist
MONGODB_COLLECTION=articles